# AI Protocol Platform — minimal self-hosted LOCAL_MODE configuration
#
# Docker Compose quick start:
#   cp .env.selfhost.example .env
#   # configure ONE provider below
#   docker compose up -d --build
#
# Source-development quick start:
#   cp .env.selfhost.example backend/.env
#   make dev-local
#
# No GCP project, Firebase credentials, Firestore, Vertex Session, GCS or
# Cloud Trace credentials are required for this self-hosted baseline.

# ---------------------------------------------------------------------------
# Model provider — configure the provider used by your selected Skill/model.
# Unused providers may stay empty.
# ---------------------------------------------------------------------------

# Option A: Gemini Express Mode (zero-GCP reference path).
GEMINI_API_KEY=

# Option B: OpenAI official API.
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# Option C: any OpenAI-compatible endpoint (DeepSeek, Qwen gateway, vLLM,
# LiteLLM Proxy, OneAPI/NewAPI, or an internal gateway). The exact model name
# is declared in backend/config/models.yaml with `provider: openai`.
# OPENAI_API_KEY=your-key-or-local-placeholder
# OPENAI_API_BASE=http://host.docker.internal:8000/v1

# Option D: Anthropic direct API.
ANTHROPIC_API_KEY=

# Optional display name baked into the Compose frontend image.
APP_NAME=AI Protocol Platform

# Optional: skip frontend lint/type checks while iterating on an image build.
# Keep false for normal validation builds.
SKIP_QUALITY_CHECKS=false

# Optional local auth signing secret. The default in docker-compose.yml is a
# deliberately insecure LOCAL_MODE-only marker; override it if desired.
# GROUP_AUTH_SIGNING_SECRET=

# Optional local CORS setting used by source-development scripts.
ALLOW_ORIGINS=http://localhost:3456

# Persist the LOCAL_MODE Firestore fixture across container/source restarts.
LOCAL_MODE_PERSIST=1

# Do not set production/cloud markers in LOCAL_MODE:
# K_SERVICE=
# GAE_ENV=
# KUBERNETES_SERVICE_HOST=
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=
