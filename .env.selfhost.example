# AI Protocol Platform — production-style self-hosted configuration
#
# Source-build Docker Compose quick start:
#   cp .env.selfhost.example .env
#   # 1) configure JWT_SIGNING_KEY + first admin credentials
#   # 2) configure ONE model provider below
#   docker compose up -d --build
#
# Prebuilt GHCR image quick start (docker-compose.release.yml):
#   cp .env.selfhost.example .env
#   # set APP_VERSION to a release tag, e.g. v1.0.0
#   docker compose -f docker-compose.release.yml pull
#   docker compose -f docker-compose.release.yml up -d
#
# SELF_HOSTED_MODE is intentionally NOT LOCAL_MODE. The latter is a developer
# mode with an auth stub / fixtures; this file describes the durable deployment
# path that uses PostgreSQL + local volumes + built-in JWT without GCP.

SELF_HOSTED_MODE=1
LOCAL_MODE=0

# ---------------------------------------------------------------------------
# Release images — used by docker-compose.release.yml only. `latest` is
# convenient for evaluation; production should pin APP_VERSION to an immutable
# semver release tag or override each image with a sha-* tag.
# ---------------------------------------------------------------------------
APP_VERSION=latest
# BACKEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-backend
# FRONTEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-frontend
# MCP_SANDBOX_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-mcp-sandbox

# Browser-visible origins. The MCP Apps sandbox MUST be a different origin from
# the frontend. Local defaults use different ports. For a reverse proxy use,
# for example:
#   MCP_SANDBOX_PUBLIC_URL=https://mcp.example.com
#   MCP_SANDBOX_ALLOWED_HOST_ORIGINS=https://ai.example.com
#   ALLOW_ORIGINS=https://ai.example.com
MCP_SANDBOX_PUBLIC_URL=http://localhost:3457
MCP_SANDBOX_ALLOWED_HOST_ORIGINS=http://localhost:3456
FRONTEND_PUBLIC_URL=http://localhost:3456

# ---------------------------------------------------------------------------
# Persistence — one PostgreSQL service is reused for platform data, ADK Session
# and durable Memory. No Redis / separate Session DB / separate Memory DB.
# ---------------------------------------------------------------------------
DATA_BACKEND=postgres
SESSION_BACKEND=postgres
MEMORY_BACKEND=postgres

POSTGRES_DB=aip
POSTGRES_USER=aip
POSTGRES_PASSWORD=aip-local-change-me
DATABASE_URL=postgresql://aip:aip-local-change-me@postgres:5432/aip
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# Memory currently mirrors ADK InMemoryMemoryService semantics (keyword/text
# recall) but persists rows in PostgreSQL. This caps the per-user recall scan;
# semantic/vector search can later use pgvector without adding another service.
MEMORY_SEARCH_SCAN_LIMIT=2000

# ---------------------------------------------------------------------------
# Binary/object storage — self-host defaults to the backend's persistent /data
# Docker volume. PostgreSQL keeps metadata; binary bytes live under tenant-safe
# namespaces beneath this root. ADK FileArtifactService uses the same durable
# volume but a separate directory. MinIO/S3 is NOT required by default.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/data/objects
ARTIFACT_BACKEND=local
ADK_ARTIFACT_ROOT=/data/artifacts

# Optional cloud/provider adapters (not used by the default self-host stack):
# OBJECT_STORAGE_BACKEND=gcs
# ARTIFACT_BACKEND=gcs
# OBJECT_STORAGE_GCS_BUCKET=your-bucket
# GOOGLE_CLOUD_PROJECT=your-project

# ---------------------------------------------------------------------------
# Authentication — built-in JWT is the default Self-host identity provider.
# ---------------------------------------------------------------------------
# Account records live in Repository/PostgreSQL. Passwords are scrypt-hashed;
# short-lived bearer tokens are signed by the backend. Firebase remains an
# optional AUTH_BACKEND=firebase provider. AUTH_BACKEND=stub is LOCAL_MODE only.
AUTH_BACKEND=local-jwt

# REQUIRED for local-jwt. Generate a random secret with at least 32 bytes, e.g.:
#   openssl rand -base64 48
# The backend fails during startup if this is missing/too short.
JWT_SIGNING_KEY=
# During key rotation, put prior valid keys here as a comma-separated list.
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ISSUER=ai-protocol-platform
JWT_AUDIENCE=ai-protocol-platform
JWT_EXPIRE_MINUTES=60

# REQUIRED on the FIRST local-jwt startup when auth_users is empty. This account
# receives the platform-admin role. Once created, later restarts do not overwrite
# its password/roles, and these bootstrap values may be removed from `.env`.
SELFHOST_ADMIN_EMAIL=
SELFHOST_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional GCP capabilities — all disabled in the baseline Self-host profile.
# Setting one of the corresponding GCP backends/flags opts back into that
# provider explicitly; stale ADC on the host is never enough to enable it.
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=false
TRACE_EXPORT_ENABLED=0
CLOUD_LOGGING_ENABLED=0
VERTEX_SEARCH_ENABLED=0
OTEL_SDK_DISABLED=true

# ---------------------------------------------------------------------------
# Model provider — the baseline root path is OpenAI-compatible and therefore
# needs no Google model/API. PLATFORM_DEFAULT_MODEL may be any registered model
# or logical tier in backend/config/models.yaml. If your gateway exposes a
# different model name (DeepSeek/Qwen/vLLM/etc.), register that model with
# provider: openai and point PLATFORM_DEFAULT_MODEL at its registry id.
# ---------------------------------------------------------------------------
PLATFORM_DEFAULT_MODEL=gpt-5-6-terra
MODEL_RESIDENCY_POLICY=unrestricted

# Default Self-host path: OpenAI official OR any OpenAI-compatible endpoint.
# For official OpenAI, leave OPENAI_API_BASE empty or set api.openai.com/v1.
# For DeepSeek/Qwen/vLLM/LiteLLM/OneAPI/NewAPI, set the gateway URL here.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Alternative A: Gemini Developer API (not Vertex AI). Set
# PLATFORM_DEFAULT_MODEL=lite (or another registered Google model) and provide:
GEMINI_API_KEY=

# Alternative B: Anthropic direct API. Set PLATFORM_DEFAULT_MODEL to a
# registered Claude model and provide:
ANTHROPIC_API_KEY=

APP_NAME=AI Protocol Platform
SKIP_QUALITY_CHECKS=false

# Anonymous group-auth signing secret. Leave unset unless that feature is used.
# It is separate from built-in local JWT and has no insecure production default.
# GROUP_AUTH_SIGNING_SECRET=

ALLOW_ORIGINS=http://localhost:3456

# The baseline does NOT require or set any of the following:
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=
# ADK_ARTIFACT_BUCKET=
# FIREBASE_CONFIG=
