# AI Protocol Platform — minimal self-hosted LOCAL_MODE configuration
#
# Copy the model section into backend/.env, then run:
#   make dev-local
#
# LOCAL_MODE itself is pinned by scripts/dev-local.sh. No GCP project,
# Firebase credentials, Firestore, Vertex Session, GCS or Cloud Trace
# credentials are required for this baseline.

# Gemini Express Mode is the current zero-GCP reference provider for Phase 0.
# Create a key in Google AI Studio and paste it below.
GEMINI_API_KEY=

# Optional local CORS setting.
ALLOW_ORIGINS=http://localhost:3456

# Optional: preserve the local Firestore fixture between restarts.
# LOCAL_MODE_PERSIST=1

# Do not set production/cloud markers in LOCAL_MODE:
# K_SERVICE=
# GAE_ENV=
# KUBERNETES_SERVICE_HOST=
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=

# OpenAI-compatible provider/base-url generalisation is tracked separately
# in Roadmap Issue #2. This Phase 0 file intentionally documents only the
# provider path that is known to require no GCP credentials.
