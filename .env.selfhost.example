# AI Protocol Platform 自托管配置模板
# 完整操作顺序见 docs/configuration-guide.md。
# 源码：复制本文件为 .env，配置后执行 docker compose up -d --build。
# 发布镜像：下载 Release 的 default.env.selfhost.example 保存为 .env。
# 发布部署固定 APP_VERSION；已有部署合并配置，不覆盖旧密钥和数据连接。

SELF_HOSTED_MODE=1
LOCAL_MODE=0

# 发布镜像参数，仅 docker-compose.release.yml 使用。
# Release 生成时固定为实际版本；源码模板保留 latest 供显式选择。
APP_VERSION=latest
# 以下填写镜像仓库名，版本标签由 APP_VERSION 追加。
# BACKEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-backend
# FRONTEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-frontend
# MCP_SANDBOX_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-mcp-sandbox

# 浏览器公共源：前端与 MCP Apps 沙箱必须不同源。
MCP_SANDBOX_PUBLIC_URL=http://localhost:3457
MCP_SANDBOX_ALLOWED_HOST_ORIGINS=http://localhost:3456
FRONTEND_PUBLIC_URL=http://localhost:3456

# 语言与品牌：源码前端构建参数，变更后重建。
# 默认简体中文，用户可在界面切换语言。
# 发布前端仅支持已实现的认证模式/沙箱 URL 运行时替换。
DEFAULT_LOCALE=zh-CN
APP_NAME=AI Protocol Platform
APP_TAGLINE=Open Agent Protocol Platform
APP_DESCRIPTION=Self-hosted agent platform for Skills, AG-UI, A2UI, MCP and MCP Apps.
APP_SLUG=platform
CITATION_SCHEME=aip
ENABLE_SKILL_STUDIO=true
APP_FAVICON=/images/logo/platform-mark.svg
APP_LOGO_HERO=/images/logo/platform-mark.svg
APP_LOGO_AVATAR=/images/logo/platform-mark.svg
APP_CONTACT_EMAIL=
APP_GITHUB_REPO=https://github.com/yuklcool/ai-protocol-platform
# HSL 主题色数值。
APP_PRIMARY_HSL=234 57% 59%
APP_PRIMARY_FOREGROUND_HSL=210 40% 98%

# 持久化：复用 PostgreSQL 保存平台数据、Session 和 Memory。
DATA_BACKEND=postgres
SESSION_BACKEND=postgres
MEMORY_BACKEND=postgres
POSTGRES_DB=aip
POSTGRES_USER=aip
# 首次启动前更换密码，并同步修改 DATABASE_URL。
# 已有数据卷不会因修改此变量自动重置数据库密码。
POSTGRES_PASSWORD=aip-local-change-me
DATABASE_URL=postgresql://aip:aip-local-change-me@postgres:5432/aip
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
MEMORY_SEARCH_SCAN_LIMIT=2000

# 对象与 Artifact：默认使用 backend 持久化 /data 卷。
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/data/objects
ARTIFACT_BACKEND=local
ADK_ARTIFACT_ROOT=/data/artifacts

# 可选 GCS；额外变量需显式传入 backend。
# OBJECT_STORAGE_BACKEND=gcs
# ARTIFACT_BACKEND=gcs
# OBJECT_STORAGE_GCS_BUCKET=your-bucket
# GOOGLE_CLOUD_PROJECT=your-project

# 可选 S3 兼容存储，不自动创建存储服务或搬迁旧数据。
# 默认 Compose 未传递下列 S3 变量，按 docs/s3-object-storage.md 添加覆盖文件。
# Artifact 独立配置；IAM/工作负载凭证可不填显式密钥。
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_S3_BUCKET=your-bucket
# OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_S3_REGION=us-east-1
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
# OBJECT_STORAGE_S3_SESSION_TOKEN=
# OBJECT_STORAGE_S3_ADDRESSING_STYLE=auto
# 多数自托管端点使用 path；R2 按服务配置使用 auto 区域。

# 认证：默认内置 local JWT，不需要外部身份服务。
AUTH_BACKEND=local-jwt
# 必填随机签名密钥，使用 openssl rand -base64 48 生成；重启保持稳定。
JWT_SIGNING_KEY=
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ISSUER=ai-protocol-platform
JWT_AUDIENCE=ai-protocol-platform
JWT_EXPIRE_MINUTES=60
# 本地账号库为空时必填；后续变更不覆盖已有密码/角色。
SELFHOST_ADMIN_EMAIL=
SELFHOST_ADMIN_PASSWORD=

# 可选企业 OIDC，先建立本地授权账号和 issuer/sub 映射。
# AUTH_BACKEND=oidc
# OIDC_ISSUER=https://id.example.com/realms/platform
# OIDC_CLIENT_ID=ai-protocol-platform
# OIDC_AUDIENCE=ai-protocol-platform
# OIDC_DISCOVERY_URL=
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_REDIRECT_URI=http://localhost:3456/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_TRANSACTION_TTL_SECONDS=300
# 公开 PKCE 客户端使用 none，机密客户端按服务选择下列认证方式。
# OIDC_CLIENT_AUTH_METHOD=none
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# OIDC_CLIENT_AUTH_METHOD=client_secret_post
# OIDC_CLIENT_SECRET=

# 默认关闭可选 GCP 能力。
GOOGLE_GENAI_USE_VERTEXAI=false
TRACE_EXPORT_ENABLED=0
CLOUD_LOGGING_ENABLED=0
VERTEX_SEARCH_ENABLED=0
OTEL_SDK_DISABLED=true

# 模型：此值必须是注册表模型 ID，自定义模型按控制台注册并选择。
PLATFORM_DEFAULT_MODEL=gpt-5-6-terra
MODEL_RESIDENCY_POLICY=unrestricted
# 通用预算执行器。
# off 禁用预算执行器；in-memory 使用单进程预算执行器。
# Root 的 budgetEnabled 需要已注册执行器；off 时不能开启 Root 预算。
BUDGET_ENFORCER=off

# OpenAI 官方或兼容服务；控制台密钥引用填写 ${OPENAI_API_KEY}。
OPENAI_API_KEY=
OPENAI_API_BASE=
# 可选 Gemini Developer API / Anthropic 原生适配凭证。
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SKIP_QUALITY_CHECKS=false

# 仅使用匿名分组认证时设置。
# GROUP_AUTH_SIGNING_SECRET=
ALLOW_ORIGINS=http://localhost:3456

# 默认不要求下列云端参数；启用可选能力时按实际适配显式传入。
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=
# ADK_ARTIFACT_BUCKET=
# FIREBASE_CONFIG=
