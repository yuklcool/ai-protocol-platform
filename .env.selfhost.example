# AI Protocol Platform — self-hosted configuration
#
# Docker Compose quick start:
#   cp .env.selfhost.example .env
#   # configure ONE model provider below
#   docker compose up -d --build
#
# This file targets the durable Docker self-host path. For source-only local
# development without PostgreSQL, use DATA_BACKEND=memory,
# SESSION_BACKEND=memory and MEMORY_BACKEND=memory (make dev-local keeps the
# historical in-memory developer experience).

# ---------------------------------------------------------------------------
# Persistence — one PostgreSQL service is reused for platform data, ADK Session
# and durable Memory. No Redis / separate Session DB / separate Memory DB.
# ---------------------------------------------------------------------------
DATA_BACKEND=postgres
SESSION_BACKEND=postgres
MEMORY_BACKEND=postgres

POSTGRES_DB=aip
POSTGRES_USER=aip
POSTGRES_PASSWORD=aip-local-change-me
DATABASE_URL=postgresql://aip:aip-local-change-me@postgres:5432/aip
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# Memory currently mirrors ADK InMemoryMemoryService semantics (keyword/text
# recall) but persists rows in PostgreSQL. This caps the per-user recall scan;
# semantic/vector search can later use pgvector without adding another service.
MEMORY_SEARCH_SCAN_LIMIT=2000

# ---------------------------------------------------------------------------
# Binary/object storage — self-host defaults to the backend's persistent /data
# Docker volume. PostgreSQL keeps metadata; binary bytes live under tenant-safe
# namespaces beneath this root. ADK FileArtifactService uses the same durable
# volume but a separate directory. MinIO/S3 is NOT required by default.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/data/objects
ADK_ARTIFACT_ROOT=/data/artifacts

# Optional cloud/provider adapters (not used by the default self-host stack):
# OBJECT_STORAGE_BACKEND=gcs
# OBJECT_STORAGE_GCS_BUCKET=your-bucket
# OBJECT_STORAGE_BACKEND=s3  # reserved; adapter is intentionally not enabled yet

# ---------------------------------------------------------------------------
# Model provider — configure the provider used by your selected Skill/model.
# Unused providers may stay empty.
# ---------------------------------------------------------------------------

# Option A: Gemini Express Mode.
GEMINI_API_KEY=

# Option B: OpenAI official API.
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# Option C: any OpenAI-compatible endpoint (DeepSeek, Qwen gateway, vLLM,
# LiteLLM Proxy, OneAPI/NewAPI, or an internal gateway). The model name is
# declared in backend/config/models.yaml with provider: openai.
# OPENAI_API_KEY=your-key-or-local-placeholder
# OPENAI_API_BASE=http://host.docker.internal:8000/v1

# Option D: Anthropic direct API.
ANTHROPIC_API_KEY=

MODEL_RESIDENCY_POLICY=unrestricted
APP_NAME=AI Protocol Platform
SKIP_QUALITY_CHECKS=false

# Optional local auth signing secret. The Compose default is intentionally
# LOCAL_MODE-only and should not be reused for an internet-facing deployment.
# GROUP_AUTH_SIGNING_SECRET=

ALLOW_ORIGINS=http://localhost:3456
LOCAL_MODE_PERSIST=1

# Do not set production/cloud markers in LOCAL_MODE:
# K_SERVICE=
# GAE_ENV=
# KUBERNETES_SERVICE_HOST=
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=
