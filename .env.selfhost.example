# AI Protocol Platform — production-style self-hosted configuration
#
# Source-build Docker Compose quick start:
#   cp .env.selfhost.example .env
#   # 1) configure JWT_SIGNING_KEY + first admin credentials
#   # 2) configure ONE model provider below
#   docker compose up -d --build
#
# Prebuilt GHCR image quick start (docker-compose.release.yml):
#   cp .env.selfhost.example .env
#   # set APP_VERSION to a release tag, e.g. v1.0.0
#   docker compose -f docker-compose.release.yml pull
#   docker compose -f docker-compose.release.yml up -d

SELF_HOSTED_MODE=1
LOCAL_MODE=0

# ---------------------------------------------------------------------------
# Release images — used by docker-compose.release.yml only.
# ---------------------------------------------------------------------------
APP_VERSION=latest
# BACKEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-backend
# FRONTEND_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-frontend
# MCP_SANDBOX_IMAGE=ghcr.io/yuklcool/ai-protocol-platform-mcp-sandbox

# Browser-visible origins. MCP Apps sandbox must be a different browser origin.
MCP_SANDBOX_PUBLIC_URL=http://localhost:3457
MCP_SANDBOX_ALLOWED_HOST_ORIGINS=http://localhost:3456
FRONTEND_PUBLIC_URL=http://localhost:3456

# ---------------------------------------------------------------------------
# Language and branding — source-build frontend configuration.
# Default UI language is Simplified Chinese; users can switch to English in UI.
# These values are build-time NEXT_PUBLIC settings for the source-build path.
# ---------------------------------------------------------------------------
DEFAULT_LOCALE=zh-CN
APP_NAME=AI Protocol Platform
APP_TAGLINE=Open Agent Protocol Platform
APP_DESCRIPTION=Self-hosted agent platform for Skills, AG-UI, A2UI, MCP and MCP Apps.
APP_SLUG=platform
CITATION_SCHEME=aip
APP_FAVICON=/images/logo/platform-mark.svg
APP_LOGO_HERO=/images/logo/platform-mark.svg
APP_LOGO_AVATAR=/images/logo/platform-mark.svg
APP_CONTACT_EMAIL=
APP_GITHUB_REPO=https://github.com/yuklcool/ai-protocol-platform
# HSL triplets consumed by Tailwind CSS variables.
APP_PRIMARY_HSL=199 89% 48%
APP_PRIMARY_FOREGROUND_HSL=210 40% 98%

# ---------------------------------------------------------------------------
# Persistence — one PostgreSQL service is reused for platform data, ADK Session
# and durable Memory. No Redis / separate Session DB / separate Memory DB.
# ---------------------------------------------------------------------------
DATA_BACKEND=postgres
SESSION_BACKEND=postgres
MEMORY_BACKEND=postgres

POSTGRES_DB=aip
POSTGRES_USER=aip
POSTGRES_PASSWORD=aip-local-change-me
DATABASE_URL=postgresql://aip:aip-local-change-me@postgres:5432/aip
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
MEMORY_SEARCH_SCAN_LIMIT=2000

# ---------------------------------------------------------------------------
# Binary/object storage — self-host defaults to the backend persistent /data
# Docker volume. MinIO/S3 is optional and is NOT started by default Compose.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/data/objects
ARTIFACT_BACKEND=local
ADK_ARTIFACT_ROOT=/data/artifacts

# Optional GCS adapter:
# OBJECT_STORAGE_BACKEND=gcs
# ARTIFACT_BACKEND=gcs
# OBJECT_STORAGE_GCS_BUCKET=your-bucket
# GOOGLE_CLOUD_PROJECT=your-project

# Optional S3-compatible adapter (AWS S3, Cloudflare R2, MinIO/AIStor,
# Ceph RGW, Garage, LocalStack, etc.). Artifact storage remains independently
# configurable; enabling object-storage S3 does not start an S3 service.
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_S3_BUCKET=your-bucket
# OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_S3_REGION=us-east-1
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
# OBJECT_STORAGE_S3_SESSION_TOKEN=
# OBJECT_STORAGE_S3_ADDRESSING_STYLE=auto
#
# For AWS IAM roles/workload identity, leave explicit key/token values empty.
# For many self-hosted S3-compatible endpoints use ADDRESSING_STYLE=path.
# Cloudflare R2 commonly uses REGION=auto and its account endpoint URL.

# ---------------------------------------------------------------------------
# Authentication — built-in JWT is the default Self-host identity provider.
# ---------------------------------------------------------------------------
AUTH_BACKEND=local-jwt

# REQUIRED for local-jwt. Generate with e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ISSUER=ai-protocol-platform
JWT_AUDIENCE=ai-protocol-platform
JWT_EXPIRE_MINUTES=60

# REQUIRED on the first local-jwt startup when auth_users is empty.
SELFHOST_ADMIN_EMAIL=
SELFHOST_ADMIN_PASSWORD=

# Optional enterprise OIDC adapter. Keep AUTH_BACKEND=local-jwt unless SSO is
# intentionally enabled. OIDC authenticates the external subject, while local
# auth_users / tenant / groupTags remain the authorization authority.
# AUTH_BACKEND=oidc
# OIDC_ISSUER=https://id.example.com/realms/platform
# OIDC_CLIENT_ID=ai-protocol-platform
# OIDC_CLIENT_SECRET=
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=auto
# OIDC_REDIRECT_URI=http://localhost:3456/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_EMAIL_CLAIM=email
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# OIDC_ALLOWED_ALGORITHMS=RS256,RS384,RS512,ES256,ES384
# OIDC_DISCOVERY_TTL_SECONDS=300
# OIDC_JWKS_TTL_SECONDS=300
# OIDC_HTTP_TIMEOUT_SECONDS=10
# OIDC_CLOCK_SKEW_SECONDS=60
# For trusted local Keycloak/Authentik development only:
# OIDC_ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------------
# Optional GCP capabilities — disabled in the baseline Self-host profile.
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=false
TRACE_EXPORT_ENABLED=0
CLOUD_LOGGING_ENABLED=0
VERTEX_SEARCH_ENABLED=0
OTEL_SDK_DISABLED=true

# ---------------------------------------------------------------------------
# Model Provider.
# ---------------------------------------------------------------------------
PLATFORM_DEFAULT_MODEL=gpt-5-6-terra
MODEL_RESIDENCY_POLICY=unrestricted

# OpenAI official or any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Gemini Developer API alternative.
GEMINI_API_KEY=

# Anthropic direct API alternative.
ANTHROPIC_API_KEY=

SKIP_QUALITY_CHECKS=false

# Anonymous group-auth signing secret. Leave unset unless that feature is used.
# GROUP_AUTH_SIGNING_SECRET=

ALLOW_ORIGINS=http://localhost:3456

# The baseline does NOT require or set any of the following:
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT=
# AGENT_ENGINE_ID=
# ADK_ARTIFACT_BUCKET=
# FIREBASE_CONFIG=
