        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "intent": {
          "enum": [
            "inspect_lamp",
            "compare_pole",
            "compare_circuit",
            "inspect_rtu",
            "inspect_rtu_alarm",
            "downstream",
            "energy_view",
            "decompose_energy",
            "reconcile_energy",
            "retry"
          ],
          "title": "Intent",
          "type": "string"
        },
        "row_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Id"
        },
        "energy_view": {
          "anyOf": [
            {
              "enum": [
                "night",
                "week",
                "volatility",
                "saving"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy View"
        }
      },
      "required": [
        "id",
        "label",
        "intent"
      ],
      "title": "Action",
      "type": "object"
    },
    "Chart": {
