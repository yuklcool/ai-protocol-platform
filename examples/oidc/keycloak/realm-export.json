        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "oidc-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "owner@example.com",
      "firstName": "OIDC",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "oidc-demo-password",
          "temporary": false
        }
      ]
    }
  ]
