{
  "realm": "ai-protocol-platform",
  "enabled": true,
  "displayName": "AI Protocol Platform OIDC Demo",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "ai-protocol-platform",
      "name": "AI Protocol Platform",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3456/auth/oidc/callback"
